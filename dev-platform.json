{
  "_说明": "multica（fork）接入共用底座（~/dev-platform）的配置：工作目录隔离、合并闸、测试台、iOS 主包与手机分支测试包、Mac 主包与桌面分支测试包、按改动跑测试。本机正在用的 Multica 跑的是官方镜像、不从这个仓库部署，所以不登记 main.after_sync 和 release.deploy。iOS 主包连本机自己的 Multica：服务器地址是本机私有配置，写在安装页工具的 apps.json（build_settings），不进仓库（仓库公开）。Mac 主包（multica-mac 同在那里登记）连本机靠 ~/.multica/desktop.json，也不在仓库里。",
  "linear_project": "multica",
  "base_branch": "main",
  "node": "22",
  "merge": {
    "checks": "python3 scripts/dev/client_adapter_test.py && bash scripts/dev-env.test.sh && pnpm -C apps/mobile exec vitest run && pnpm -C apps/mobile typecheck && pnpm -C apps/desktop exec vitest run scripts/client-runtime.test.mjs scripts/mac-update-floor.test.mjs && pnpm -C apps/desktop typecheck:node",
    "method": "squash",
    "on_confirmed": "~/dev-platform/tools/merge/gate.py confirm --linear"
  },
  "worktree": {
    "port_range": [
      42101,
      42199
    ],
    "setup": "scripts/dev/dp_env.sh setup",
    "teardown": "scripts/dev/dp_env.sh teardown \"$DP_REAL_ROOT\""
  },
  "testbench": {
    "up": "scripts/dev/dp_env.sh up",
    "down": "scripts/dev/dp_env.sh down",
    "restore": "scripts/dev/dp_env.sh restore"
  },
  "release": {
    "packages": {
      "ios": {
        "hub_id": "multica",
        "paths": "^apps/mobile/",
        "settings": [
          "CURRENT_PROJECT_VERSION={commit_count}"
        ]
      },
      "mac": {
        "hub_id": "multica-mac",
        "paths": "^(apps/desktop/|packages/core/|packages/views/|packages/ui/)"
      }
    },
    "branch_package": {
      "platforms": {
        "ios": {
          "paths": "^(apps/mobile/|server/|packages/core/|scripts/dev/(publish_ios_test_build\\.sh|client_adapter\\.py|testbench_auth\\.py|dp_env\\.sh)$|scripts/dev-env\\.sh$)",
          "publish": "scripts/dev/publish_ios_test_build.sh"
        },
        "mac": {
          "paths": "^(apps/desktop/|server/|packages/core/|packages/views/|packages/ui/|scripts/dev/(publish_mac_test_build\\.sh|client_adapter\\.py|testbench_auth\\.py|dp_env\\.sh)$|scripts/dev-env\\.sh$)",
          "publish": "scripts/dev/publish_mac_test_build.sh"
        }
      }
    }
  },
  "not_needed": {
    "release.deploy": "本机正在用的 Multica 跑的是官方镜像（docker compose），不从这个仓库部署，没有要盯梢的线上部署。",
    "main.after_sync": "本机正在用的 Multica 跑的是官方镜像（容器 multica-backend-1 等），不跑主库代码，合并后主库上没有要跟着重启的本机服务。"
  },
  "tests": {
    "runner": "cd apps/mobile && pnpm exec vitest run $(printf '%s\\n' {tests} | sed 's#^apps/mobile/##')",
    "pattern": "^apps/mobile/.*\\.test\\.(ts|tsx)$",
    "related": [
      {
        "match": "^(apps/mobile/.+)\\.(ts|tsx)$",
        "tests": [
          "\\1.test.ts",
          "\\1.test.tsx"
        ]
      }
    ]
  },
  "client": {
    "version": 1,
    "backend": {
      "port_env_file": ".env.worktree",
      "port_key": "PORT",
      "health_path": "/health",
      "identity": {
        "commit": "commit",
        "instance": [
          "pid",
          "started_at"
        ],
        "pid": "pid"
      }
    },
    "testbench": {
      "port": "worktree"
    },
    "public": {
      "url_command": [
        "python3",
        "scripts/dev/client_adapter.py",
        "public-url"
      ],
      "connect_ip_command": [
        "tailscale",
        "ip",
        "-4"
      ]
    },
    "registries": [
      {
        "glob": "~/.multica/dev/envs/*/manifest.env",
        "dir_key": "DIR",
        "ports": {
          "backend": "BACKEND_PORT",
          "testbench": "FRONTEND_PORT"
        }
      }
    ],
    "data": {
      "manifest": "data/client-data.json",
      "probe": {
        "command": [
          "python3",
          "scripts/dev/client_adapter.py",
          "probe"
        ],
        "timeout": 60
      }
    },
    "artifacts": {
      "ios": {
        "path_command": [
          "python3",
          "scripts/dev/client_adapter.py",
          "artifact-path",
          "--platform",
          "ios"
        ],
        "api_target": "public",
        "inspect": {
          "command": [
            "python3",
            "scripts/dev/client_adapter.py",
            "inspect",
            "--platform",
            "ios",
            "--artifact",
            "{artifact}"
          ],
          "timeout": 120
        }
      },
      "mac": {
        "path_command": [
          "python3",
          "scripts/dev/client_adapter.py",
          "artifact-path",
          "--platform",
          "mac"
        ],
        "api_target": "backend",
        "inspect": {
          "command": [
            "python3",
            "scripts/dev/client_adapter.py",
            "inspect",
            "--platform",
            "mac",
            "--artifact",
            "{artifact}"
          ],
          "timeout": 120
        }
      }
    }
  },
  "ios_debug": {
    "bundle_id": "ai.multica.mobile.dev",
    "native_inputs": [
      "apps/mobile/app.config.ts",
      "apps/mobile/package.json",
      "package.json",
      "pnpm-lock.yaml",
      "apps/mobile/assets/icon.png",
      "apps/mobile/patches/expo-modules-core@57.0.21.patch"
    ],
    "native_input_plist_key": "DPNativeInputsSHA256",
    "scheme": "exp+multica-mobile",
    "flow": "apps/mobile/.maestro/client-smoke.yaml",
    "runtime_probe": {
      "command": [
        "python3",
        "scripts/dev/client_adapter.py",
        "probe-client",
        "--app-path",
        "{app_path}",
        "--metro-url",
        "{metro_url}"
      ],
      "timeout": 45
    },
    "database": {
      "port_offset": 20000,
      "url_env_file": ".env.worktree",
      "url_key": "DATABASE_URL"
    },
    "environment_registry": {
      "glob": "~/.multica/dev/envs/*/manifest.env",
      "dir_key": "DIR",
      "port_key": "BACKEND_PORT"
    },
    "backend": {
      "owner": "worktree",
      "port_env_file": ".env.worktree",
      "port_key": "PORT",
      "path": "/health",
      "status": 200
    },
    "metro": {
      "owner": "worktree",
      "port_env_file": ".env.worktree",
      "port_key": "METRO_PORT",
      "path": "/status",
      "contains": "packager-status:running"
    },
    "services": {
      "backend": {
        "mode": "oneshot",
        "command": [
          "scripts/dev/dp_env.sh",
          "up"
        ],
        "stop": [
          "scripts/dev/dp_env.sh",
          "down"
        ]
      },
      "metro": {
        "command": [
          "pnpm",
          "-C",
          "apps/mobile",
          "exec",
          "expo",
          "start",
          "--dev-client",
          "--port",
          "{metro_port}",
          "--host",
          "lan"
        ],
        "env": {
          "EXPO_PUBLIC_API_URL": "http://127.0.0.1:{backend_port}"
        }
      }
    }
  }
}
