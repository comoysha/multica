    "environment_registry": {
      "glob": "~/.multica/dev/envs/*/manifest.env",
      "dir_key": "DIR",
      "port_key": "BACKEND_PORT"
    },
    "backend": {
      "owner": "worktree",
      "port_env_file": ".env.worktree",
      "port_key": "PORT",
      "path": "/health",
      "status": 200
    },
    "metro": {
      "owner": "worktree",
      "port_env_file": ".env.worktree",
      "port_key": "METRO_PORT",
      "path": "/status",
      "contains": "packager-status:running",
      "device_url_env_file": ".env.ios-device",
      "device_url_env": "IOS_DEVICE_METRO_URL",
      "ready_file": ".env.ios-device"
    },
    "services": {
      "backend": {
        "mode": "oneshot",
        "command": [
          "scripts/dev/dp_env.sh",
          "up"
        ],
        "stop": [
          "scripts/dev/dp_env.sh",
          "down"
        ]
      },
      "metro": {
        "command": [
          "python3",
          "scripts/dev/ios_metro.py"
        ]
      }
    },
    "target": {
      "kind": "physical",
      "pool": "default"
    },
    "physical_runner": {
      "team": "8ALC9Q43AC",
      "mode": "shared"
    },
    "physical_app": "build/ios-device/DerivedData/Build/Products/Debug-iphoneos/MulticaStaging.app",
    "simulator_flow": "apps/mobile/.maestro/client-smoke.yaml"
  },
